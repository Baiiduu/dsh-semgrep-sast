{
  "manifestVersion": 1,
  "semgrepVersion": "1.175.0",
  "platform": "win32",
  "architecture": "x64",
  "launcher": {
    "executable": "runtime/python/python.exe",
    "arguments": [
      "-m",
      "semgrep"
    ]
  },
  "environment": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONNOUSERSITE": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "SEMGREP_SEND_METRICS": "off"
  }
}
